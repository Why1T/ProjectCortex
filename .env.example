# ============================================================
# Cortex configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ============================================================

# --- Alpaca paper trading credentials ------------------------
# Get these from https://app.alpaca.markets/paper (view API keys)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_API_SECRET=your_paper_api_secret_here
ALPACA_PAPER=true

# --- LLM API for deep analysis (optional but recommended) ----
# Cortex uses AI-driven reasoning for trade ideas, news and social sentiment.
# Any OpenAI-compatible endpoint works.
CORTEX_LLM_API_KEY=
CORTEX_LLM_BASE_URL=https://api.openai.com/v1
CORTEX_LLM_MODEL=gpt-4o-mini
CORTEX_LLM_TEMPERATURE=0.3

# --- Risk configuration --------------------------------------
# Maximum % of account equity risked per trade (0.01 = 1%)
CORTEX_RISK_PER_TRADE=0.01
# Maximum position size as % of equity (0.20 = 20%)
CORTEX_MAX_POSITION_PCT=0.20

# --- News ----------------------------------------------------
# Free-tier news endpoint on Alpaca (unfortunately requires a
# non-paper data subscription). Cortex will attempt it and gracefully
# fall back to a public RSS-based aggregator if unavailable.
CORTEX_NEWS_MAX_ITEMS=25

# --- TradingView ---------------------------------------------
# Uses TradingView's public scanner datafeed (no key required) to pull its
# composite multi-timeframe recommendation and chart links for all six
# swing timeframes. Set false to disable the TradingView layer entirely.
CORTEX_TV_ENABLED=true
CORTEX_TV_TIMEOUT=25
